{
  "sections": {
    "breadcrumb": {
      "type": "esw-breadcrumb",
      "settings": {
        "skip_handles": "all, frontpage, bestsellers, new-in, value-sets"
      }
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "rating": {
          "type": "esw_rating"
        },
        "title": {
          "type": "title"
        },
        "best_for": {
          "type": "esw_best_for"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "purchase_options": {
          "type": "esw_purchase_options",
          "settings": {
            "subscribe_default_types": "Face Mask, Facial Mist, Eye Patches"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "shipping_bar": {
          "type": "esw_shipping_bar"
        },
        "routine_pair": {
          "type": "esw_routine_pair"
        },
        "description": {
          "type": "description"
        },
        "sticky_atc": {
          "type": "esw_sticky_atc"
        }
      },
      "block_order": [
        "rating",
        "title",
        "best_for",
        "price",
        "variant_picker",
        "purchase_options",
        "quantity_selector",
        "buy_buttons",
        "shipping_bar",
        "routine_pair",
        "description",
        "sticky_atc"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "cover",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 12,
        "padding_bottom": 36
      }
    },
    "details": {
      "type": "esw-product-details",
      "blocks": {
        "ingredients": {
          "type": "ingredients"
        },
        "how_to": {
          "type": "how_to"
        },
        "faq": {
          "type": "faq"
        }
      },
      "block_order": [
        "ingredients",
        "how_to",
        "faq"
      ],
      "settings": {
        "color_scheme": "scheme-1"
      }
    },
    "reviews": {
      "type": "esw-app-slot",
      "settings": {
        "heading": "Reviews",
        "anchor": "reviews",
        "link_label": "",
        "link": "",
        "empty_note": "Add the Yotpo Reviews app block here.",
        "color_scheme": "scheme-1"
      }
    },
    "creator_videos": {
      "type": "esw-app-slot",
      "settings": {
        "heading": "See it on real skin",
        "anchor": "creator-videos",
        "link_label": "",
        "link": "",
        "empty_note": "Add the Tolstoy app block here.",
        "color_scheme": "scheme-1"
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "breadcrumb",
    "main",
    "details",
    "reviews",
    "creator_videos",
    "related-products"
  ]
}
