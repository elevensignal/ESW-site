{% comment %}
  Heading + app blocks. Used for Yotpo reviews and Tolstoy creator videos on the
  PDP and "As seen on TikTok" on the homepage (SPEC 2, 5.2 #7, 5.3 #11-12).
  The anchor lets other elements link here (the PDP rating links to #reviews).
{% endcomment %}
{{ 'esw-sections.css' | asset_url | stylesheet_tag }}

{%- assign anchor = section.settings.anchor | handleize -%}
<div
  class="esw-app-slot color-{{ section.settings.color_scheme }} gradient"
  {% if anchor != blank %}
    id="{{ anchor }}"
  {% endif %}
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.link_label != blank -%}
      <div class="esw-section-head">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {% render block %}
    {%- else -%}
      {%- if request.design_mode -%}
        <p class="esw-app-slot__empty">{{ section.settings.empty_note | escape }}</p>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "ESW: app slot",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "reviews",
      "info": "Lets links jump here, e.g. #reviews."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "empty_note",
      "label": "Editor note when empty",
      "default": "Add an app block here (Yotpo reviews or Tolstoy videos).",
      "info": "Only shown in the theme editor."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "ESW: app slot"
    }
  ]
}
{% endschema %}
