{% comment %}
  Product grid from a collection (SPEC 5.2 #5 Bestsellers). Out-of-stock
  products are always skipped (SPEC 10), so the grid never shows a sold-out card.
{% endcomment %}
{{ 'esw-sections.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- assign source = section.settings.collection -%}
<div class="esw-grid-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="esw-section-head">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if source != blank and section.settings.link_label != blank -%}
        <a href="{{ source.url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>

    <ul class="esw-grid list-unstyled" role="list">
      {%- if source != blank -%}
        {%- assign shown = 0 -%}
        {%- for product in source.products -%}
          {%- if shown >= section.settings.limit -%}
            {%- break -%}
          {%- endif -%}
          {%- if product.available -%}
            {%- assign shown = shown | plus: 1 -%}
            <li>
              {% render 'card-product', card_product: product, section_id: section.id, skip_styles: true %}
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li>{% render 'card-product', skip_styles: true %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "ESW: product grid",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 4,
      "max": 8,
      "step": 4,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop all"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "ESW: product grid"
    }
  ]
}
{% endschema %}
