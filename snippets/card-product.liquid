{% comment %}
  ESW product card (SPEC 3.3). Replaces Dawn's card so every grid, search result
  and recommendation uses the same card:
  1:1 image, badge, rating + count, title, "Best for" one-liner, price and
  exactly one button. No "Buy now", no sale or sold-out badge.

  Keeps Dawn's parameter names so existing sections render it unchanged.

  Accepts:
  - card_product: {Object} Product Liquid object (optional)
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
  - skip_styles: {Boolean} Don't include component styles (optional)
  - section_id: {String} The ID of the section that contains this card.
  - show_rating: {Boolean} Ignored; the card always shows the rating when one exists.
  - quick_add: {String} Ignored; the card always has one add-to-cart button.

  Usage:
  {% render 'card-product', card_product: product, section_id: section.id %}
{% endcomment %}
{%- unless skip_styles -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- endunless -%}
{%- if card_product and card_product != empty -%}
  {%- liquid
    assign variant = card_product.selected_or_first_available_variant
    assign card_id = section_id | append: '-' | append: card_product.id
    assign form_id = 'CardForm-' | append: card_id
    assign best_for = card_product.metafields.esw.best_for.value
    assign image = card_product.featured_media.preview_image
    assign image_alt = card_product.featured_media.alt | default: card_product.title

    assign has_qty_rules = false
    if variant.quantity_rule.min > 1 or variant.quantity_rule.max != null or variant.quantity_rule.increment > 1
      assign has_qty_rules = true
    endif
  -%}
  <product-component view-event-payload="{{ card_product | standard_event_data: 'view', context: product_view_context | escape }}">
    <article class="esw-card" aria-labelledby="CardTitle-{{ card_id }}">
      <div class="esw-card__media">
        <a href="{{ card_product.url }}" class="esw-card__media-link" tabindex="-1" aria-hidden="true">
          {%- if image -%}
            {%- liquid
              assign loading = 'lazy'
              if lazy_load == false
                assign loading = 'eager'
              endif
            -%}
            {{
              image
              | image_url: width: 720
              | image_tag:
                widths: '180, 270, 360, 540, 720',
                sizes: '(min-width: 990px) 280px, (min-width: 750px) 33vw, 50vw',
                alt: image_alt,
                loading: loading,
                class: 'esw-card__image'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'esw-card__image placeholder-svg' }}
          {%- endif -%}
        </a>
        {% render 'esw-badges', product: card_product %}
      </div>

      <div class="esw-card__body">
        {% render 'esw-rating', product: card_product %}

        <h3 class="esw-card__title" id="CardTitle-{{ card_id }}">
          <a href="{{ card_product.url }}" class="full-unstyled-link">{{ card_product.title | escape }}</a>
        </h3>

        {%- if best_for != blank -%}
          <p class="esw-card__best-for">{{ 'esw.product.best_for' | t: text: best_for }}</p>
        {%- endif -%}

        {% render 'price', product: card_product, price_class: 'esw-card__price' %}
      </div>

      <div class="esw-card__action">
        {%- if card_product.available == false -%}
          <button type="button" class="button button--full-width" disabled>
            {{ 'products.product.sold_out' | t }}
          </button>
        {%- elsif card_product.has_only_default_variant and has_qty_rules == false -%}
          <product-form data-section-id="{{ section_id }}" data-hide-errors="true">
            {%- form 'product',
              card_product,
              id: form_id,
              class: 'form',
              novalidate: 'novalidate',
              data-type: 'add-to-cart-form'
            -%}
              <input type="hidden" name="id" value="{{ variant.id }}" class="product-variant-id">
              <button
                type="submit"
                name="add"
                class="button button--primary button--full-width"
                aria-describedby="CardTitle-{{ card_id }}"
              >
                <span>{{ 'products.product.add_to_cart' | t }}</span>
                {%- render 'loading-spinner' -%}
              </button>
            {%- endform -%}
          </product-form>
        {%- else -%}
          <a
            href="{{ card_product.url }}"
            class="button button--primary button--full-width"
            aria-describedby="CardTitle-{{ card_id }}"
          >
            {{ 'esw.product.choose_options' | t }}
          </a>
        {%- endif -%}
      </div>
    </article>
  </product-component>
{%- else -%}
  <article class="esw-card esw-card--placeholder">
    <div class="esw-card__media">
      {{ 'product-1' | placeholder_svg_tag: 'esw-card__image placeholder-svg' }}
    </div>
    <div class="esw-card__body">
      <h3 class="esw-card__title">{{ 'onboarding.product_title' | t }}</h3>
      {% render 'price', placeholder: true %}
    </div>
  </article>
{%- endif -%}
